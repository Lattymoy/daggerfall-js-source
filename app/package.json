{
  "name": "daggerfall-js-app",
  "productName": "Daggerfall Online",
  "private": true,
  "version": "0.1.0",
  "description": "Daggerfall Online - the downloadable desktop shell. Loads the same dist/ the website deploys; adds ARENA2-from-disk and file-backed saves.",
  "author": "Lattymoy",
  "homepage": "https://daggerfalljs.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lattymoy/daggerfall-js-source.git"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "predist": "cd .. && npm run build",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.daggerfalljs.app",
    "productName": "Daggerfall Online",
    "icon": "../public/icons/icon-512.png",
    "afterPack": "./afterPack.cjs",
    "artifactName": "DaggerfallOnline-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lattymoy",
        "repo": "daggerfall-js-source"
      }
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "launcherPreload.cjs",
      "launcher/**",
      {
        "from": "../src/ui",
        "to": "launcher",
        "filter": [
          "menuPad.js"
        ]
      },
      "lib/**",
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "DaggerfallOnline-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "DaggerfallOnline-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "Daggerfall Online looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded.",
        "NSDesktopFolderUsageDescription": "Daggerfall Online looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded.",
        "NSDocumentsFolderUsageDescription": "Daggerfall Online looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded."
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

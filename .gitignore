node_modules/
dist/
# the gun lab's own build (vite.config.gun.js)
dist-gun/
dist-pistol/
.DS_Store

# Original game data - freeware but not redistributable. NEVER commit.
ARENA2/
arena2/
*.BSA
*.bsa
DAGGER.SND
*.SND
test-harness/
back-drafts/

# Disposable agent worktrees (nested checkouts) - never commit.
.claude/worktrees/
node_modules

# The desktop shell's packaged installers (electron-builder output).
app/release/
# DA13: the bundled game's index, written by the release workflow before electron-builder packs it.
app/game-seed.json

# tools/parity: reproducible from prepare.sh / run.sh. cs/api holds DFU's
# own sources (kept EXTERNAL per Port-Doctrine); out/ reaches ~2.4GB.
tools/parity/dfu/
tools/parity/cs/api/
tools/parity/cs/*.exe
tools/parity/out/
tools/mutation/*.jsonl
tools/mutation/*.log
.mutaudit/

# Generated by tools/neutral/build-viewer.mjs (needs ARENA2 to build).
dagger-viewer.html

# AUDIT 21 (doctrine F1): the before/after galleries are SCREENSHOTS OF THE
# GAME. A frame of the port's framebuffer with a WEAPON*.CIF sprite drawn into
# it is ARENA2 art, upscaled - and public/ is Vite's static root, so anything
# under it was copied into dist/ and uploaded to GitHub Pages by deploy.yml.
# Regenerate galleries locally with tools/fpProbe.mjs; they do not ship.
public/visual-changes/

# transient audit scratch dropped in the repo root by tooling runs
.ast*.mjs
.eslint.audit*.config.js

# V4's playthrough screenshots (tools/firstHourProbe.mjs default SHOTS dir).
firsthour-shots/
# CASTLE1: the castle probe's shots (tools/castleProbe.mjs default SHOTS dir).
castle-shots/
# MAP-LANE: the map lane probe's shots (tools/mapLaneProbe.mjs default SHOTS dir).
maplane-shots/
# AUDIT 68: tools/dumpMidi.mjs's default outDir - Standard MIDI renders of the
# player's MIDI.BSA, which is ARENA2 music. Never commit.
midi-out/
# AUDIT 68: the probes' generated pages (<name>.tmp.html beside the page they
# drive); a probe killed before its finally can leave one behind.
*.tmp.html

# THE ONE ALLOWED .BSA: the MW fixture archive is OURS - written by
# test/fixtures/mw/generate.py from pyffi-authored meshes and a hand-
# packed DDS, no game data in it. The corpus guard above ate it SILENTLY
# on two slices (git add -A stages nothing ignored and says nothing),
# a parallel session had to force-add it after CI went red.
!test/fixtures/mw/fixture.bsa

# Python bytecode from the fixture generators.
__pycache__/
*.pyc
prototype/

# ONLINE1: wrangler's local state beside the relay
server/.wrangler/

# Probe output (tools/enhancedLightingProbe.mjs PNGs and the like) - never commit.
scratch/

# EM5: the enhanced map probe writes its shots here - pictures for a
# person to look at, not source the repo carries.
artifacts/

# QUICK-LOOT-STATS: tools/quickLootStatsProbe.mjs writes its PNGs here -
# the same rule, and for the same reason: the PROBE is the source, the
# pictures are what it prints.
tools/shots/

# AUDIT-ACC F5: wrangler`s local state - the workerd build of the Worker
# and the local D1 that `npm run account` and `wrangler dev` create.
# Build artifacts and a throwaway database; neither belongs in the tree.
.wrangler/
# ...and the file wrangler reads local secrets from, which is exactly
# the kind of file a signing key gets pasted into by accident.
.dev.vars
.dev.vars.*

# tools/mutate.mjs: a source file's backup while a mutant is applied in place
*.mutbak
# TAMRIEL1: the fit probe's render of the player's own picture (tools/tamrielFitProbe.mjs default --out).
tamriel-shots/
# WEAPON-GLOW1 (AUDIT DOC-16): the glow probe's pictures (tools/weaponGlowProbe.mjs default outDir) - no game data, never committed.
weapon-glow-probe/
# STUDIO1: tools/studioArt.mjs templates' default dir - the painted pictures an artist starts from (the port's own; regenerated on demand).
# Anchored (AUDIT STUDIO1 C4): unanchored, it ignored a folder of that name inside an artist's, and nothing they put there was committed.
/studio-templates/
# AUDIT STUDIO1 C7: what an artist's computer leaves beside their pictures (macOS's AppleDouble files, Windows' thumbnails and folder settings).
._*
Thumbs.db
desktop.ini

  {
    "name": "the-panel-describes-row-zero-rather-than-the-lit-one",
    "file": "src/systems/quickLoot.js",
    "old": "  const row = quickLootRow(frame);\n  if (row < 0) return [];\n  return itemStatRows(frame?.rows?.[row]?.item ?? null);",

    "name": "FIELD-GUN14-3-the-shaft-is-drawn-through-the-orb",
    "file": "src/combat/arrowFlight.js",
    "old": "      if (!m.dead && !m.orb && m.gpu) renderer.drawMesh(m.gpu, arrowMatrix(m.pos, m.dir), texRemap);",

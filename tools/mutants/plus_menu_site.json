  {
    "name": "AUDIT-EQ-the-bar-unclamped",
    "file": "src/ui/enhancedAccount.js",
    "old": "        b.value = Math.max(0, Math.min(max, value));",
    "new": "        b.value = value;",
    "tests": [
      "test/plus_menu_site.test.js"
    ],
    "equivalent": true,
    "why": "No caller can leave the range (won <= won + lost; a level's xp in is under its need), and a real <progress> clamps its value to [0, max] itself - the clamp is belt and braces for the fake document alone."
  },
  {
    "name": "AUDIT-EQ-host-not-restored-after",
    "file": "src/ui/enhancedAccount.js",
    "old": "      host = root;\n      // AUDIT PROFILE-MENU P2",
    "new": "      // AUDIT PROFILE-MENU P2",
    "tests": [
      "test/plus_menu_site.test.js"
    ],
    "equivalent": true,
    "why": "build() sets host = root at its top on every paint, and wardrobe()/patreonRow() are called only inside the signed-in block with host set just before each - the restore after the block is redundant with the reset before the next."
  },
  {
    "name": "AUDIT-EQ-a-face-repaints-a-form",
    "file": "src/ui/enhancedAccount.js",
    "old": "if (art) { faceArt = art; if (flow.stage === 'in') paint(); }",
    "new": "if (art) { faceArt = art; paint(); }",
    "tests": [
      "test/plus_menu_site.test.js"
    ],
    "equivalent": true,
    "why": "A repaint of a form puts the focus and caret back (AUDIT TERMS1 T3's focusBack), so an extra paint when a face lands on a sign-in card is invisible; the stage check only spares the work."
  }
]

  {
    "name": "REL8-merge-diffed-against-both-parents",
    "file": "scripts/updateNumber.mjs",
    "old": "'--diff-merges=first-parent', '--no-patch', '-1',",
    "new": "'--no-patch', '-1',",
    "tests": [
      "test/rel8_updates.test.js"
    ],
    "equivalent": true,
    "why": "equivalent on git 2.31 and later, where --first-parent implies --diff-merges=first-parent; the flag says it for an older git, which would skip a merge's diff and miss the merge that brought the line"
  },
  {
    "name": "REL8-since-any-output",
    "file": "scripts/updateNumber.mjs",
    "old": "    if (!/^[0-9a-f]{40,64}$/.test(since)) return null;",
    "new": "    if (!since) return null;",
    "tests": [
      "test/rel8_updates.test.js"
    ],
    "equivalent": true,
    "why": "equivalent: with --no-patch git prints the commit's hash alone or nothing, so the shape check never refuses an answer the emptiness check lets through - it guards a git that answers otherwise (REL8-merge-patch-read-as-commit is that answer, and dies)"
  },

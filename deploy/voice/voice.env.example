# the voice service's environment - copy to voice.env (git-ignored) and fill every line.
# The LiveKit pair: the SAME key and secret written under `keys:` in livekit.yaml.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The URL the GAME CLIENT opens - the public wss:// your proxy terminates TLS for and forwards to livekit:7880.
LIVEKIT_URL=wss://voice.example.com
# The account service's public key, base64url raw Ed25519 - GET https://<account service>/v1/pubkey -> .key
IDENTITY_PUBLIC_KEY=
# The one origin allowed to call this service (the site), or * while proving
CORS_ORIGIN=https://lattymoy.github.io
# Optional: the relay's https door for the party word and the room-presence check; unset,
# party voice is refused in words and proximity voice refuses every join
# RELAY_URL=https://daggerfall-online.mackcothran.workers.dev
# Required whenever RELAY_URL is set: the secret the relay's own VOICE_RELAY_SECRET checks this service's requests
# against (server/wrangler.toml - a Worker SECRET there, never a var, the same way GATE_SIGNING_KEY is)
VOICE_RELAY_SECRET=
